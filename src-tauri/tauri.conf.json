{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bulk WA Sender",
  "version": "1.0.0",
  "identifier": "cyou.schrist.bulkwasender",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": null,
    "beforeBuildCommand": "node ../scripts/prepare_runtime.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bulk WA Sender - by schrist.",
        "width": 1500,
        "height": 920,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "runtime/node.exe": "runtime/node.exe",
      "runtime/engine.cjs": "runtime/engine.cjs",
      "../sample_data/Sample_Contact_List.xlsx": "sample_data/Sample_Contact_List.xlsx",
      "../sample_data/Sample_Contact_List.csv": "sample_data/Sample_Contact_List.csv",
      "../sample_data/attachments/*": "sample_data/attachments/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
