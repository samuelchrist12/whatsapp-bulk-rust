# ==========================================
# Bulk WA Sender - Comprehensive Gitignore
# by schrist.
# ==========================================

# Binaries & Large Executables (Exceeds GitHub 100MB limit)
*.exe
*.dll
*.pdb
*.so
*.dylib
app.exe
Bulk_WA_Sender.exe
dist/
**/dist/

# Rust Build Directory
target/
**/target/
src-tauri/target/
**/*.rs.bk

# WhatsApp Sessions & Private Credentials (CRITICAL)
.wwebjs_cache/
**/.wwebjs_cache/
.wwebjs_auth/
**/.wwebjs_auth/
.wa_session/
**/.wa_session/
sidecar/.wa_session/
browser.pid
**/browser.pid

# Local User Configurations & Runtime Preferences
bulk_wa_preferences.json
ANALISIS_DAN_PENGEMBANGAN.md
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node Dependencies
node_modules/
**/node_modules/

# OS Generated Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo

